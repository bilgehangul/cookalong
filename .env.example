# Recipe extraction - OpenAI is primary, Gemini is the automatic fallback.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Video metadata + transcript (required)
SERPAPI_KEY=

# Shopping links (optional - falls back to a Walmart search)
TAVILY_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-2.5-flash
